# initramfs contents for the STM32F7-DISCO port (gen_init_cpio format).
#
# Kept explicit rather than scanning ./initdir so that symlinks survive on a
# Windows host: the old directory scan shipped four 217 KB copies of busybox
# (bin/busybox, bin/sh, sbin/busybox, sbin/sh), all resident in RAM.
#
# Paths on the right are relative to the kernel source tree.

dir /bin 0755 0 0
dir /sbin 0755 0 0
dir /etc 0755 0 0
dir /etc/init.d 0755 0 0
dir /dev 0755 0 0
dir /dev/input 0755 0 0
dir /dev/pts 0755 0 0
dir /proc 0755 0 0
dir /sys 0755 0 0
dir /mnt 0755 0 0
dir /mnt/root 0755 0 0
dir /mnt/sd 0755 0 0
dir /tmp 1777 0 0
dir /var 0755 0 0
dir /var/log 0755 0 0
dir /lib 0755 0 0
dir /lib/modules 0755 0 0
dir /lib/modules/2.6.33-arm1 0755 0 0
dir /usr 0755 0 0
dir /usr/bin 0755 0 0

file /init initdir/init 0755 0 0

file /bin/busybox initdir/bin/busybox 0755 0 0
slink /bin/sh busybox 0777 0 0
slink /sbin/init ../bin/busybox 0777 0 0
slink /sbin/reboot ../bin/busybox 0777 0 0
slink /sbin/halt ../bin/busybox 0777 0 0
slink /sbin/poweroff ../bin/busybox 0777 0 0
slink /linuxrc bin/busybox 0777 0 0

file /bin/uart_bridge initdir/bin/uart_bridge 0755 0 0
file /bin/bbx initdir/bin/bbx 0755 0 0
file /bin/f7fetch initdir/bin/f7fetch 0755 0 0
file /bin/pinsample initdir/bin/pinsample 0755 0 0
file /bin/regsample initdir/bin/regsample 0755 0 0
file /bin/ethtx initdir/bin/ethtx 0755 0 0
file /bin/fbtest_rgb565 initdir/bin/fbtest_rgb565 0755 0 0
file /sbin/sdinstall initdir/sbin/sdinstall 0755 0 0

file /etc/inittab initdir/etc/inittab 0644 0 0
file /etc/init.d/rcS initdir/etc/init.d/rcS 0755 0 0
file /etc/profile initdir/etc/profile 0644 0 0
file /etc/fstab initdir/etc/fstab 0644 0 0
file /etc/hostname initdir/etc/hostname 0644 0 0

nod /dev/console 0600 0 0 c 5 1
nod /dev/null 0666 0 0 c 1 3
nod /dev/zero 0666 0 0 c 1 5
nod /dev/mem 0640 0 0 c 1 1
nod /dev/random 0666 0 0 c 1 8
nod /dev/urandom 0666 0 0 c 1 9
nod /dev/tty 0666 0 0 c 5 0
nod /dev/ptmx 0666 0 0 c 5 2
nod /dev/tty0 0660 0 0 c 4 0
nod /dev/tty1 0660 0 0 c 4 1
nod /dev/tty2 0660 0 0 c 4 2
nod /dev/tty3 0660 0 0 c 4 3
nod /dev/tty4 0660 0 0 c 4 4
nod /dev/vcs1 0660 0 0 c 7 1
nod /dev/vcsa1 0660 0 0 c 7 129
nod /dev/ttyS0 0600 0 0 c 4 64
nod /dev/ttyS1 0600 0 0 c 4 65
nod /dev/ttyS2 0600 0 0 c 4 66
nod /dev/ttyS5 0600 0 0 c 4 69
nod /dev/fb0 0660 0 0 c 29 0
nod /dev/input/event0 0644 0 0 c 13 64
nod /dev/mmcblk0 0660 0 0 b 179 0
nod /dev/mmcblk0p1 0660 0 0 b 179 1
nod /dev/mmcblk0p2 0660 0 0 b 179 2
nod /dev/mmcblk0p3 0660 0 0 b 179 3
nod /dev/mmcblk0p4 0660 0 0 b 179 4
